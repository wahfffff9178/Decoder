# Maintainer: wahfffff9178 aaa893285@outlook.com
pkgname=deccoder
pkgver=2.1.2
pkgrel=1
pkgdesc="A lightweight, cross-platform CLI encryption tool with ChaCha20 and HMAC-SHA256."
arch=('x86_64' 'aarch64')
url="https://github.com/wahfffff9178/deccoder"
license=('GPL-3.0-only')
depends=('gcc-libs')
makedepends=('cmake')
source=("deccoder-2.1.2.tar.gz")
sha256sums=('088395990d435dd601cfd9617f4dbdab5b541a0528b82f2e6363036ef80e1443')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
}
